{
  "name": "@vvi/inline-style",
  "version": "1.0.6",
  "type": "module",
  "private": true,
  "scripts": {
    "b": "rollup --config rollup.config.js && tsc -p tsconfig.types.json",
    "clean:package": "node scripts/clean-package-json.js",
    "build": "jja rm dist && pnpm run b && pnpm run clean:package",
    "diff": "jja pkg --diff 淘宝",
    "eslint": "jja cls && eslint src",
    "beautify": "pnpm run prettier",
    "prettier": "jja cls && prettier . --write",
    "push:version": "gvv",
    "push": "gvv",
    "vjj": "vjj",
    "test": "jja cls && rollup --config rollup.config.test.js && node test/out/test/index.mjs",
    "prepublishOnly": "pjj"
  },
  "jja": {
    "pkg": [
      "eslint",
      "typescript"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.9.5",
    "@vvi/check-version": "^1.1.2",
    "@vvi/node": "^5.0.0",
    "@vvi/rollup-external": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "globals": "^17.7.0",
    "gvv": "^1.0.2",
    "jja": "^2.5.4",
    "pjj": "^1.0.7",
    "prettier": "^3.9.5",
    "rollup": "^4.62.2",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-copy": "^3.5.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vjj": "^1.0.14"
  },
  "dependencies": {
    "@vvi/is": "^2.0.6"
  }
}